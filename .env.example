# Compose reads .env for interpolation. Go itself reads process environment only.
# Development listen address; the demo fixes its internal address at :8080.
HTTP_ADDR=:8080
# Leave unset to use each mode's default: demo 8080, development 5173.
# If overriding, match the browser address exactly.
# BROWSER_ORIGIN=http://127.0.0.1:8080
# Disposable local development credentials only; never reuse outside this lab.
DATABASE_URL=postgres://gateway:gateway-local-only@postgres:5432/gateway?sslmode=disable
SHUTDOWN_TIMEOUT=5s
# Outer Docker deadline must exceed SHUTDOWN_TIMEOUT.
APP_STOP_GRACE_PERIOD=15s

# Compose reads .env for interpolation. Go itself reads process environment only.
HTTP_ADDR=:8080
# Match the browser address exactly. For Go-served assets, use port 8080.
BROWSER_ORIGIN=http://127.0.0.1:5173
# Optional until database connectivity is implemented. No password is included.
# Example shape: postgres://gateway@postgres:5432/gateway?sslmode=disable
DATABASE_URL=
SHUTDOWN_TIMEOUT=5s
# Outer Docker deadline must exceed SHUTDOWN_TIMEOUT.
APP_STOP_GRACE_PERIOD=15s

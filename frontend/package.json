{
  "name": "go-ssh-term-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "test": "bun run test:unit && bun run test:ui && bun run test:contract",
    "format": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "check": "bun --bun biome check .",
    "routes": "bun --bun tsr generate",
    "typecheck": "bun run routes && bun --bun tsc --noEmit && bun --bun tsc --noEmit -p tsconfig.test.json",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "test:unit": "bun test ./tests/*.test.ts",
    "test:ui": "bun test --preload ./tests/ui/setup.ts ./tests/ui",
    "contract:gen": "bun scripts/contract.mjs generate",
    "api:gen": "bun scripts/contract.mjs api",
    "contract:watch": "bun scripts/contract.mjs watch",
    "test:contract": "bun test scripts/contract.test.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@happy-dom/global-registrator": "20.14.5",
    "@sinonjs/fake-timers": "15.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.40",
    "@tanstack/router-plugin": "1.168.42",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sinonjs__fake-timers": "15.0.1",
    "@vitejs/plugin-react": "6.1.1",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}

{
  "name": "go-ssh-term-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "bun --bun vite",
    "format": "bun --bun biome format --write .",
    "lint": "bun --bun biome lint .",
    "check": "bun --bun biome check .",
    "typecheck": "bun --bun tsc --noEmit",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.41",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "daisyui": "5.7.47",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
